# Dependency install scripts are the supply-chain attack surface that matters
# most for a tool whose whole purpose is auditing untrusted endpoints: a
# postinstall hook runs with the developer's full privileges and environment,
# including whatever API keys are exported in that shell. Block all of them.
#
# pnpm 10 already refuses to run dependency build scripts unless they are
# allowlisted in `pnpm-workspace.yaml`. This setting is broader (it covers every
# lifecycle script, not just build ones) and keeps the guarantee if the
# repository is ever installed by an older pnpm. CI passes `--ignore-scripts`
# explicitly as well, so the protection does not depend on this file being read.
#
# Tradeoff, recorded so it is not rediscovered as a bug: this also skips *our
# own* `prepare` script on `pnpm install`. There is none today. Anything added
# later (a git-hook installer, for instance) needs its own explicit `pnpm run`
# step rather than relying on the lifecycle.
ignore-scripts=true

# The pnpm >=8 default, stated explicitly because it flipped between major
# versions. A transitive peer range that lags a new major would otherwise block
# installs for every contributor; our own peer surface is small enough that
# warnings are the right severity.
#
# This is *not* a lockfile-drift guard - that is `--frozen-lockfile`, which CI
# passes on every install.
strict-peer-dependencies=false
